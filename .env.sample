# Django
DEBUG=True
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=shifta_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery & Channels)
REDIS_URL=redis://localhost:6379/0

# Embedly (wallets, payouts) — https://developer.embedly.ng
# Staging: https://waas-staging.embedly.ng/api/v1/ and https://payout-staging.embedly.ng/api/
# Production: https://waas-prod.embedly.ng/api/v1/ and https://payout-prod.embedly.ng/api/
EMBEDLY_API_KEY=
EMBEDLY_BASE_URL=https://waas-staging.embedly.ng/api/v1/
EMBEDLY_PAYOUT_URL=https://payout-staging.embedly.ng/api/
# Organisation ID: Embedly dashboard > Profile Settings
EMBEDLY_ORGANISATION_ID=
EMBEDLY_COUNTRY_ID=c15ad9ae-c4d7-4342-b70f-de5508627e3b
EMBEDLY_CURRENCY_ID=fd5e474d-bb42-4db1-ab74-e8d2a01047e9
EMBEDLY_CUSTOMER_TYPE_ID=f671da57-e281-4b40-965f-a96f4205405e
# Platform (escrow) wallet: set up with `python manage.py setup_platform_wallet`
# (stored in the database). Setting this overrides that.
EMBEDLY_PLATFORM_ACCOUNT_NUMBER=
# Where Embedly sends users after the KYC liveness selfie (e.g. an app deep link)
EMBEDLY_LIVENESS_REDIRECT_URL=
# Webhook HMAC key; leave blank to use the API key
EMBEDLY_WEBHOOK_SECRET=
# Staging only: how test payouts resolve (success | failed)
EMBEDLY_STAGING_PAYOUT_STATUS=success
# Wallet-to-wallet single-debit cap (larger transfers are split)
EMBEDLY_MAX_TRANSFER_AMOUNT=100000
WITHDRAWAL_FEE_PERCENT=2.5
WITHDRAWAL_MIN_AMOUNT=500
WITHDRAWAL_MAX_AMOUNT=1000000

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
# Where Paystack returns the facility after a card payment: the facility web
# app's wallet page, which verifies the payment. Must be YOUR domain.
PAYSTACK_CALLBACK_URL=https://shifta-frontend.vercel.app/facility/wallet

# Azure Blob Storage (Future)
AZURE_ACCOUNT_NAME=your_account_name
AZURE_ACCOUNT_KEY=your_account_key
AZURE_CONTAINER_NAME=your_container_name

# AI Service (Future)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Google Maps API
GOOGLE_MAP_API_KEY=your_google_maps_api_key
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
